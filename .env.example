LIVART_PORT=8080
SERVER_PORT=8080

POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=postgres
DB_PASSWORD=replace-with-strong-db-password
DB_SSLMODE=disable

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=livartminio
MINIO_SECRET_KEY=replace-with-strong-minio-password
MINIO_BUCKET=livart
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001

JWT_SECRET=replace-with-at-least-32-chars-secret
JWT_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
WAIT_TIMEOUT_SECONDS=120
LOCAL_OBJECT_STORE_PATH=./data/objects

# Optional server default AI gateway. If empty, users configure this in the UI.
LIVART_DEFAULT_API_BASE_URL=
LIVART_DEFAULT_API_KEY=
LIVART_DEFAULT_IMAGE_MODEL=gpt-image-2
LIVART_DEFAULT_CHAT_MODEL=gpt-5.5

# Accepted for compatibility with the original Docker environment.
RABBITMQ_DEFAULT_USER=livart
RABBITMQ_DEFAULT_PASS=replace-with-strong-rabbitmq-password
CANVAS_SAVE_QUEUE=livart.canvas.save
CANVAS_SAVE_DEAD_LETTER_QUEUE=livart.canvas.save.dead
